# ==========================================================================
# QQ 机器人配置模板
# 复制为 .env 后填写 DEEPSEEK_API_KEY 即可启动：
#     Copy-Item .env.example .env
# .env 含密钥，**不要提交到任何仓库**（本仓库的 .gitignore 已把它排除）。
# ==========================================================================

# ---------- NoneBot2 驱动 ----------
# ~fastapi+~websockets：websockets 用于主动连 NapCat；fastapi 提供 Web 控制台。
# 若只写 ~websockets，机器人照常工作，但 http://127.0.0.1:8080/ai/ 打不开。
DRIVER=~fastapi+~websockets
HOST=127.0.0.1
PORT=8080
LOG_LEVEL=INFO
COMMAND_START=["/", ""]

# ---------- 连接 NapCat（OneBot v11 正向 WebSocket）----------
# 端口要与 NapCat 里「网络配置 → WebSocket 服务端」的监听端口一致。
# 这里默认 6700 而不是 NapCat 常见的 3001，是为了避开本机其他服务的端口占用。
ONEBOT_WS_URLS=["ws://127.0.0.1:6700"]

# ---------- 模型接口（DeepSeek 只是默认的那一家）----------
# 下面三项是**首次启动时用来播种「deepseek」档案**的初值。改造后"用哪家接口、
# 哪个模型"由控制台「模型」页里的**档案**决定（存 data/models.json），可以加成
# 多份互相切换（中转站 / 自建 vLLM / Ollama / 别的厂商的兼容端点），切换即时生效、
# 不用重启；`/模型 <档案id>` 在聊天里也能切。详见 README「换一家模型接口」。
#
# 到 https://platform.deepseek.com/api_keys 申请，形如 sk-xxxxxxxx
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 官方只支持 deepseek-flash 与 deepseek-v4-pro（两者都带推理，会多花 token）；
# deepseek-chat 是兼容保留的旧名（不在 /models 列表里，但调用与 logprobs 都正常）。
DEEPSEEK_MODEL=deepseek-flash

# ---------- 触发与上下文 ----------
# 留空表示"只靠 @机器人 触发"；填 "/ai " 则同时支持前缀触发。
AI_CHAT_PREFIX=
# 留空 [] 表示所有群都响应；填 [123456789] 则只服务白名单群。
AI_CHAT_GROUP_WHITELIST=[]
# ---------- 聊天记录（本次改造的核心）----------
# 会话切分间隔（秒）。两条消息间隔超过它就算新的一轮；
# 开新一轮时上一轮遗留的未读会被归档为已读，从而走压缩通道 —— 这是省 token 的关键。
# 间隔越短，"原样送进模型"的消息越少。人少、闲聊稀疏的群设 180~300 即可。
AI_CHAT_SESSION_GAP=300
# 已读背景的字符预算：从最新往回累加，装不下的更早记录直接丢弃。
# 人少的群闲聊也少，可以调到 800 进一步省 token。
AI_CHAT_READ_BUDGET=2000
# 单条消息送进模型前的截断长度（0 = 不截断）
AI_CHAT_MSG_CLIP=120
# 聊天记录落盘目录（相对路径按项目根解析；`data/runtime/` 是挂载卷里的运行数据根）
AI_CHAT_LOG_DIR=data/runtime
# 是否记录所有群消息（false 则只记录 @机器人 / 命中前缀的消息）
AI_CHAT_RECORD_ALL=true
# 单群保留的最大消息条数（0 = 不限，文件持续增长）
AI_CHAT_MAX_MESSAGES=0
# 是否把 JSON 缩进美化（true 便于人工查看，但文件更大、写盘更慢）
AI_CHAT_LOG_PRETTY=false
# 单次请求超时（秒）
AI_CHAT_TIMEOUT=60
# 同时处理的最大提问数，防止多人并发打爆配额
AI_CHAT_MAX_CONCURRENCY=4

# ---------- 人格包 ----------
# 2026-10 包化：人格现在是**一个目录一套** —— `persona/packs/<id>/`
#   base.txt      底层人设（它是谁）—— 只有你能改：直接编辑文件
#   forbidden.txt 禁止事项（铁律）—— 只有你能改：直接编辑文件
#   surface.txt   表层模板（怎么说话）—— 只作**首次播种**，实际生效的那份在
#                 `data/runtime/persona/<id>/surface.txt`（自动迭代唯一会写的东西）
#   traits.json   特质 / 通道 / 闸门关键词（缺了闸门回退内置默认表，仍能跑）
#
# 本仓库随附两个样本包：
#   assistant  最小可用的中性人格（下面默认用它）
#   example    照《人格包内容规范》逐条演示的参照样本
# 换角色 = 换目录：**不用重启**（三层都是每轮现读）。
# 切换入口：群里 `/人设 切换 <id>`、Web 控制台「人设要求」页、桌面控制台「人格」页。
# 每个包的自我学习成果按包分开存，切回来接着用。
# 新建一个包：照抄 `persona/_TEMPLATE/`（那份 README 里有步骤）。
#
# ① 默认激活哪个包（**部署期**的默认值）。
#    运行时切换会写 `data/runtime/persona/_active`，那个优先级更高，
#    所以切完人格**不需要回来改这一行**。
AI_CHAT_PERSONA_PACK=assistant
#
# 【可选 · 逃生舱】下面三个变量显式配了就**绕过人格包**、直接读那个路径。
# 包化之前它们是唯一的人设来源（平铺在仓库根目录的 `persona_base.txt` /
# `persona_forbidden.txt` / `persona_surface.txt`，那份布局已废弃、文件已删除）。
# 留着会让"切人格"看起来没生效（包换了，读的还是旧那三个文件）。
# **除非要临时回退，否则保持注释。**
# 写成**空串** = 关掉这一层文件读取，退回下面的 AI_CHAT_SYSTEM_PROMPT。
# AI_CHAT_PERSONA_FILE=<某个底层人设文件的路径>
# AI_CHAT_FORBIDDEN_FILE=<某个禁止事项文件的路径>
# AI_CHAT_SURFACE_FILE=<某个表层人设文件的路径>
#
# 机器人自己在聊天记录里的显示名。**必须与人设里的角色名一致** —— `chatlog` 用它
# 判定"哪句话是它自己说的"，不一致时它会对着自己上一轮接话（而且不报错）。
# **包化之后建议留空**：角色名的真源是当前人格包的 `_pack.json` → `bot_name`，
# 切换人格时会跟着换；写死在这里反而会在换包/改名后与包不一致，
# 而启动日志会为此报一条 WARNING（见 `packs.py` 与 `deploy/README.md`）。
AI_CHAT_BOT_NAME=
# 只在底层人设文件缺失/被显式关掉时才生效。**别在这里再写一份人设** ——
# 两份同时存在时以文件为准，容易改了一份却没生效。
AI_CHAT_SYSTEM_PROMPT=你是一个友好、简洁的群聊助手。

# ==========================================================================
# 下面这些【可调参数】的实际入口是 Web 控制台（http://127.0.0.1:8080/ai/）：
#   主人的 QQ、表情包概率与入库阈值、主动发言的间隔/概率/冷却/日上限、上下文预算……
# 控制台改的值存在 data/settings.json，优先级高于本文件，改完即时生效、无需重启。
# 本文件里的同名项只作为【初始默认值】；控制台上点「全部恢复 .env 默认」即可回来。
# 完整的可调项清单见 plugins/ai_chat/settings.py 的 _SPECS 表。
# ==========================================================================
# 主人的 QQ 号（正整数）。留空 = 没有主人：定时问候、`/dsh` 这类
# 只面向主人的功能会全部不生效。**别把自己的 QQ 号提交进公开仓库。**
AI_CHAT_MASTER_QQ=
AI_CHAT_WEBUI_ENABLED=true
AI_CHAT_WEBUI_PREFIX=/ai

# ---------- 时间感知与定时问候（同样是控制台里的可调项）----------
# 让模型知道当前时间（注入每次回复的 prompt）。
# 关掉后它答不出「现在几点」，也分不清该说早安还是晚安。
AI_CHAT_TIME_CONTEXT=true

# ---------- 多条发送 ----------
# 一次回答里有好几个短句时，逐句分次发（像真人打字），而不是挤成一大段砸出去。
# 只在「句数达标 + 每句都不长」时才拆，否则拆了反而像挤牙膏 / 仍是长消息。
AI_CHAT_SENTENCE_SPLIT=true
# 至少几句才拆（只有两句拆开显得挤牙膏）
AI_CHAT_SENTENCE_SPLIT_MIN=3
# 每句不超过多少字才拆（有超长句就不拆）
AI_CHAT_SENTENCE_SPLIT_LEN=40
# 太短的句子并回上一条，防止「嗯。」单独发一条像刷屏。设 0 = 不合并。
# **别调大**：调到 6 会把「先看耐压。」（5 字）这类正常短句也并掉，三句就只剩两条。
AI_CHAT_SENTENCE_MERGE_UNDER=4
# 分条之间的间隔（秒）：太快会被风控判刷屏，太慢显得卡
AI_CHAT_SENTENCE_SPLIT_DELAY=0.9

# ---------- NTP 时间校准 ----------
# 机器时钟会漂，而它不只影响"答错时间"—— 定时问候判断"到 08:00 了吗"用的就是这个钟，
# 差 8 小时就等于早安安在半夜。这里用**偏移量**校准：不改系统时钟（那要管理员权限，
# 还会影响同机其它程序），只取回"真实时间与本地时钟的差"，之后所有时间读取都加它。
AI_CHAT_NTP_ENABLED=true
# 按顺序试，成功即止。国内建议用阿里云的两个。
AI_CHAT_NTP_SERVERS=ntp.aliyun.com,ntp1.aliyun.com,cn.pool.ntp.org,time.windows.com
# 同步间隔（秒）。机器时钟漂移通常很慢，太频繁没有意义。
AI_CHAT_NTP_SYNC_INTERVAL=3600
# 一轮 = 把所有服务器依次试一遍；全失败会保留上一次的偏移并记日志。
AI_CHAT_NTP_RETRIES=2

# 定时向主人问早 / 午 / 晚安。默认关闭 —— 先确认时间点和发送对象，再在控制台打开。
# 时间点写 HH:MM（留空 = 该时段不发）；补发窗口、发送对象也在控制台「定时问候」组里。
AI_CHAT_GREET_ENABLED=false
AI_CHAT_GREET_MORNING=08:00
AI_CHAT_GREET_NOON=12:30
AI_CHAT_GREET_NIGHT=23:00

# ==========================================================================
# 长期记忆 / 指令 / 图片策略（改造后新增，都有合理默认值，不写也能用）
# 这一组同样可以在控制台里改，这里是"初始默认值"。
# ==========================================================================
# ---- 长期记忆 ----
# 记住跨会话、跨重启的事实。检索完全在本地算，不花 token。
AI_CHAT_MEMORY_ENABLED=true
# 每次回复最多带几条记忆进 prompt（按相关度+重要度+时效挑）
AI_CHAT_MEMORY_RECALL_COUNT=6
# 1 = 什么都想得起来，调到 0.3 以上它就不太主动提记忆了
AI_CHAT_MEMORY_MIN_SCORE=0.18
# 记忆半衰期（天）：30 表示一个月前的记忆权重减半
AI_CHAT_MEMORY_HALF_LIFE_DAYS=30
# 群事件记忆（只在本会话内检索，不跨群串）
AI_CHAT_MEMORY_EVENTS=true
# 自动从聊天里提炼记忆。回复发出之后异步跑，不占群友等待时间。
AI_CHAT_MEMORY_EXTRACT=true
# 每天最多自动提炼几次（0 = 关闭自动提炼，仍可用 /记忆 存 手动记）
AI_CHAT_MEMORY_EXTRACT_PER_DAY=200
# 单次最多记几条 / 记忆库总条数上限（超了淘汰最不重要的，被保护的除外）
AI_CHAT_MEMORY_EXTRACT_MAX=3
AI_CHAT_MEMORY_MAX_ITEMS=800

# ---- 实时指令 ----
# 斜杠指令（/图 /风格 /记忆 /机制 /人设 /模型）默认可用。
# 打开下面这项后，「不要保存这张图片」这种**自然语言**也会被执行 ——
# 但只对主人私聊、或被 @ / 引用时生效，群里随口一句话不会误改状态。
AI_CHAT_COMMAND_NATURAL=false
# 打开后指令必须带「/」（群里出现「图 忽略」这种正常说话就不会被当成指令）
AI_CHAT_COMMAND_PREFIX_REQUIRED=false
# 允许在对话里改图片策略（关掉则 /图 与「不要保存这张图片」都失效）
AI_CHAT_IMAGE_POLICY_ENABLED=true

# ---- 表情包：近似去重 ----
# 认「内容」不认「字节」：同一张图被重新压缩 / 缩放 / 转格式后字节全变，
# 靠 pHash 判断它是不是同一张。需要 Pillow + numpy；没装则自动退回精确去重。
AI_CHAT_STICKER_NEAR_DUP=true
# 64 位感知哈希的汉明距离，越小越严。同一张图做各种变换实测都是 0 位差异；
# 调到 12 以上会开始误杀"很像但确实是两张"的表情。
AI_CHAT_STICKER_DUP_DISTANCE=8

# ---- 说话模式 ----
# 按场合自动调整语气与长度：日常（默认）/ 专注（在问正事）/ 安慰（对方情绪不好）。
# 模式只改可量化的行为参数，不换人设。也可以用 /模式 专注 手动指定。
AI_CHAT_MODE_ENABLED=true
# 本地按关键词打分，票数不够就**不判定**、交给模型按人设自己判断（改错语气比不改更糟）。
AI_CHAT_MODE_MIN_MARGIN=1
# 判出来的场合沿用多久（秒）。上一条在问报错、这一条说「谢谢」，
# 沿用同一个模式才不会突然换个人。设 0 = 每条消息都重新判。
AI_CHAT_MODE_STICKY_SECONDS=600

# ---- 联网搜索 ----
# 让它遇到不认识的词 / 知识截止之后的事时自己上网查。
# **默认关闭**：需要先配好后端，否则它不会假装搜过（工具压根不提供）。
AI_CHAT_SEARCH_ENABLED=false

# 后端选一个：
#   searxng —— 自建实例（推荐自建，免费、不依赖墙外）。公共实例大多关了 JSON，会 403。
#              自建要在 settings.yml 的 search.formats 里加上 json。
#   tavily  —— 商业 API。国内服务器实测可达，公共 SearXNG / Google / Brave 往往不通。
#              去 tavily.com 申请 key，有免费额度。
#   json    —— 任何返回 {"results":[...]} 的端点，自己拼查询串。
AI_CHAT_SEARCH_BACKEND=searxng

# searxng 填实例**基址**，不要带 /search（程序自己拼 /search?q=…&format=json）：
#     AI_CHAT_SEARCH_ENDPOINT=http://127.0.0.1:8888      # 本机自建
#     AI_CHAT_SEARCH_ENDPOINT=http://searxng:8080        # 同 compose 网络的容器
# tavily 留空即可（用内置的 https://api.tavily.com/search）
# json 填完整地址，可用 {query} 占位，例如 https://api.example.com/s?q={query}
AI_CHAT_SEARCH_ENDPOINT=

# 只有 tavily 需要（它把密钥放在请求体里）。searxng / json 留空。
# 这个值不会出现在任何回复、机制说明或控制台状态里（只报"配了没配"）。
AI_CHAT_SEARCH_API_KEY=

# tavily 的检索深度：basic = 便宜快；advanced = 更全但更贵更慢
AI_CHAT_SEARCH_DEPTH=basic

# ---------- 人设：自由风格要求 ----------
# /风格 后面跟的任何一句话都会原样记下并生效（如「/风格 更可爱一点」）。
# 这类要求不做校验，所以有条数上限；满了要先 /风格 列表 撤掉几条。
AI_CHAT_STYLE_NOTE_MAX=8

# 最多带回几条（每条摘录都会截断，太多会撑满 prompt 且带入无关内容）
AI_CHAT_SEARCH_MAX_RESULTS=5
AI_CHAT_SEARCH_TIMEOUT=12
# 配额：每会话每分钟多少次、单条消息最多几次（模型偶尔会连着搜个没完）
AI_CHAT_SEARCH_RATE_LIMIT=10
AI_CHAT_SEARCH_MAX_PER_MESSAGE=2
# 本地兜底：模型没主动查、但消息里明显有"不认识的词/需要最新信息"时先查一次
AI_CHAT_SEARCH_PREFETCH=true
# ---- 读正文：从"摘要"再往里走一步 ----
# 搜索给的摘要常常只有一两句，所以默认自动打开前几条链接读正文，一起交给模型。
# 模型也能自己用 web_fetch 工具指定 URL 深读。
AI_CHAT_SEARCH_READ_ENABLED=true
# 自动读前几条（0 = 不自动读，完全靠模型自己调 web_fetch）
AI_CHAT_SEARCH_READ_RESULTS=3
# 单条正文最多几字 —— 这是 prompt 成本的主要开关
AI_CHAT_SEARCH_READ_CHARS=800
# 单条读取超时（秒）。预读是并发的，总等待约等于它
AI_CHAT_SEARCH_READ_TIMEOUT=8
# ---- 浏览器渲染兜底：HTTP 被反爬拒绝时的最后手段 ----
# 百度百科、知乎对机房 IP 段直接 403（换 UA/Referer 都没用），但它们拦的是
# "HTTP 客户端特征" —— 真浏览器渲染出来 DOM 是完整可读的。
# 代价：单页 3–8 秒、峰值内存 200–300MB，所以只在 HTTP 失败后才走。
AI_CHAT_SEARCH_RENDER_ENABLED=true
# 含浏览器启动 + 导航 + 截图 + OCR 的总预算
AI_CHAT_SEARCH_RENDER_TIMEOUT=45
# 渲染读到的文字上限（OCR 会把导航/按钮也认进来，所以给得比普通正文宽）
AI_CHAT_SEARCH_RENDER_CHARS=1500
# 注意：读正文与搜索**共用** AI_CHAT_SEARCH_MAX_PER_MESSAGE 这个次数上限。
# 渲染读到的正文比 DOM 长时优先用 OCR，但实测 DOM 又准又快（百度百科 DOM 11706 字 / 8s，
# OCR 只有 836 字 / 37s），所以正常情况下根本不会触发 OCR。
# 查过之后在回答前加一句说明（由代码加，不靠提示词）—— 说错了别人也知道是网上来的
AI_CHAT_SEARCH_SHOW_NOTE=true
AI_CHAT_SEARCH_NOTE_PREFIX=（我查了下）

# ---- 搜索释义库（单独一份 JSON，不混进长期记忆）----
# 只沉淀「某个名词是什么意思」的结论：不存网页原文，只存一两句总结。
# 每条带**查询时间**（否则不知道查的是哪天的）与**置信度**。
AI_CHAT_SEARCH_MEMORY_ENABLED=true
# 置信度是**代码按可观测信号算的**（几个独立来源 / 有无含糊措辞 / 来源像不像百科），
# 不是让模型自评。低于这条线的仍会保留并注入，但会显眼标注「低置信度，别当准的用」。
AI_CHAT_SEARCH_MEMORY_MIN_CONFIDENCE=0.5
# 释义有效期（天）。释义比人的喜好过时得快，所以必须能过期。0 = 永不过期。
AI_CHAT_SEARCH_MEMORY_TTL_DAYS=30
# 条数上限。超了先淘汰低置信的，再淘汰最旧的。0 = 不限。
AI_CHAT_SEARCH_MEMORY_MAX=500

# ---- 表情包：发送形式与时机 ----
# QQ 里"发送文件"选一张图，上报的是 file 段、sub_type 全是 0，看不出是不是表情包。
# 这类通常是照片/素材原图，所以打分时直接扣掉这么多分（默认 0.3 → 阈值 0.6 时得考 0.9 才进来）。
AI_CHAT_STICKER_FILE_PENALTY=0.3
# 发图前把当前对话 + 几张候选图的真实画面交给模型，由它挑贴题的那张，
# 并允许它说"都不合适、这次不发"。这是"不发图文无关内容"的保证。
AI_CHAT_STICKER_PICK_BY_CONTEXT=true
AI_CHAT_STICKER_PICK_CANDIDATES=6
AI_CHAT_STICKER_PICK_CONTEXT_CHARS=600
# 注意：说话模式会缩放「发图」与「主动开口」的概率 ——
# 专注 0.15 / 0.2，安慰 0.35 / 0.3，日常 1.0 / 1.0（见上面的 AI_CHAT_MODE_*）。

