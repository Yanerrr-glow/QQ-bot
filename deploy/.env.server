# ==========================================================================
# 服务器部署用的配置模板（反向 WS 版）
#
# 用法：
#     cd deploy
#     cp .env.server .env        # Windows: Copy-Item .env.server .env
#     然后编辑 .env，把下面几个占位符换成你自己的值
#
# 【必填】
#   1. DEEPSEEK_API_KEY      你的密钥
#   2. WEBUI_TOKEN           NapCat 登录令牌，随便一串随机字符
#   3. ACCOUNT               机器人小号的 QQ 号（用于快速登录，免反复扫码）
#
# 【.env 含密钥，不要提交到任何仓库】本仓库的 .gitignore 已把它排除。
# 本模板本身不含真实密钥，可以安全提交。
# ==========================================================================

# ---------------------------------------------------------------- 必填项
DEEPSEEK_API_KEY=
WEBUI_TOKEN=<换成你自己的随机字符串>
# 反向 WS 的令牌，可留空但不建议。留空时 NapCat 侧的 token 也要留空。
ONEBOT_ACCESS_TOKEN=<换成另一串随机字符串>
# 机器人「自己」登录的那个小号 QQ —— 传给 NapCat 做快速登录。
# 【千万别漏】不填的话每次重启容器都要重新扫码。
# 注意：这是机器人自己的号，和文件末尾的 AI_CHAT_MASTER_QQ（主人）不是一回事。
ACCOUNT=<机器人小号的 QQ 号>

# ------------------------------------------------- compose 用的宿主用户 ID
# 服务器上跑 `id -u` / `id -g` 查；一般就是 1000。
NAPCAT_UID=1000
NAPCAT_GID=1000

# ---------------------------------------------------------- NoneBot2 驱动
DRIVER=~fastapi+~websockets
# 【容器里必须写 0.0.0.0】
# 写 127.0.0.1 的话，端口只绑在容器内部，宿主的 8080 映射会连不上、
# 控制台直接打不开。安全性由 compose 里的 "127.0.0.1:8080:8080" 保证 ——
# 那一层把端口锁在宿主回环上，公网依然进不来。
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=INFO
COMMAND_START=["/", ""]

# ------------------------------------------------------ 连接 NapCat
# 【反向 WS：留空】
# NapCat 主动连过来（ws://ai-chat-bot:8080/onebot/v11/ws）。
# 留空的同时必须保证没有残留的正向地址，否则 bot 会每 3 秒
# 重连一次不存在的端口，把日志刷满 ERROR。
ONEBOT_WS_URLS=[]

# 若改走【正向 WS】，把上面改成 ["ws://napcat:6700"]，
# 并在 NapCat 的 WebUI 里启用「WebSocket 服务器」、监听 0.0.0.0:6700
# （监听地址必须 0.0.0.0，写 127.0.0.1 的话同网络的 bot 容器连不上），
# 同时打开 compose 里注释掉的 6700 端口映射。

# ---------------------------------------------------------- DeepSeek
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# ------------------------------------------------------ 触发与上下文
AI_CHAT_PREFIX=
AI_CHAT_GROUP_WHITELIST=[]
AI_CHAT_SESSION_GAP=300
AI_CHAT_READ_BUDGET=2000
AI_CHAT_MSG_CLIP=120
AI_CHAT_LOG_DIR=data
AI_CHAT_RECORD_ALL=true
AI_CHAT_MAX_MESSAGES=0
AI_CHAT_LOG_PRETTY=false
AI_CHAT_TIMEOUT=60
AI_CHAT_MAX_CONCURRENCY=4

# ---------------------------------------------------------------- 人设
# 人格三层（按寿命与权限分文件，权限由文件划分钉死）：
#   ① persona_base.txt       底层人设（它是谁）—— 只有你能改
#   ② persona_forbidden.txt  禁止事项（铁律）—— 只有你能改
#   ③ persona_surface.txt    表层人设（怎么说话）—— 唯一会被自动迭代写入的一层
AI_CHAT_PERSONA_FILE=persona_base.txt
AI_CHAT_FORBIDDEN_FILE=persona_forbidden.txt
AI_CHAT_SURFACE_FILE=persona_surface.txt
AI_CHAT_BOT_NAME=鲸鱼娘
AI_CHAT_SYSTEM_PROMPT=你是一个友好、简洁的群聊助手。

# ==========================================================================
# 下面的可调参数实际入口是 Web 控制台（SSH 隧道开好后的
# http://127.0.0.1:8080/ai/）。控制台改的值存在 data/settings.json，
# 优先级高于本文件，改完即时生效。
#
# 本机已经调好的话，直接把本地 data/settings.json 一起传上来，
# 那些参数就原样跟过来了（它优先级更高，会盖住这里的默认值）。
# ==========================================================================
# 主人的 QQ 号。留空 = 没有主人：定时问候、`/dsh` 这类只面向主人的功能不生效。
AI_CHAT_MASTER_QQ=
AI_CHAT_WEBUI_ENABLED=true
AI_CHAT_WEBUI_PREFIX=/ai

# ---------------------------------------------------- 时间感知与定时问候
# 让模型知道当前时间（注入 prompt 末尾）。关掉后它答不出「现在几点」。
AI_CHAT_TIME_CONTEXT=true
# 定时向主人问早 / 午 / 晚安。默认关闭 —— 先在控制台确认时间点与发送对象，再打开。
# 时间点写 HH:MM（留空 = 该时段不发）；补发窗口 / 发送对象也在控制台「定时问候」组里。
#
# 【时区前提】Dockerfile 里的 TZ=Asia/Shanghai 不能删：容器若跑在 UTC，
# 时间感知会答错 8 小时，定时问候也会在错误的钟点触发。
# 上线后看启动日志里那行「当前时间：... 中国标准时间+0800」即可确认。
AI_CHAT_GREET_ENABLED=false
AI_CHAT_GREET_MORNING=08:00
AI_CHAT_GREET_NOON=12:30
AI_CHAT_GREET_NIGHT=23:00

# -------------------------------------------------------------- 联网搜索
# 后端是**同一台服务器上的自建 SearXNG**（另一套 compose，见 deploy/searxng/）。
# 端点写**容器名**，不是 127.0.0.1 —— 两者在同一个 docker 网络里：
#     AI_CHAT_SEARCH_ENDPOINT=http://searxng:8080
# 【不要带 /search】程序自己拼 /search?q=…&format=json。
# 没配好时可用性判定为 False，工具压根不交给模型，它也就不会假装搜过。
AI_CHAT_SEARCH_ENABLED=true
AI_CHAT_SEARCH_BACKEND=searxng
AI_CHAT_SEARCH_ENDPOINT=http://searxng:8080
# 查过的名词释义单独存一份（data/search_memory.json），只存总结、不存网页原文。
AI_CHAT_SEARCH_MEMORY_ENABLED=true
AI_CHAT_SEARCH_MEMORY_TTL_DAYS=30
